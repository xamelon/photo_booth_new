<BotHTML.admin_shell current_admin={@current_admin} current_path={@current_path}>
  <div class="page-header">
    <div>
      <h1>App</h1>
      <p class="page-subtitle">
        Project-specific admin pages live here. Keep generic bot engine pages under Bot.
      </p>
    </div>
  </div>

  <section class="panel app-placeholder">
    <h2>App-specific zone</h2>
    <p>
      Add pages like campaigns, orders, prizes, reports, moderation, or custom dashboards here.
    </p>
    <code>lib/bot_machine_example_app_web/controllers/admin/*</code>
  </section>
</BotHTML.admin_shell>
