<BotHTML.admin_shell current_admin={@current_admin} current_path={@current_path}>
  <div class="page-header">
    <div>
      <h1>App</h1>
      <p class="page-subtitle">
        Project-specific admin pages live here. Keep generic bot engine pages under Bot.
      </p>
    </div>
  </div>

  <section class="panel app-placeholder">
    <h2>PhotoBooth admin</h2>
    <p>App-specific billing and business controls for the demo PhotoBooth bot.</p>
    <p>
      <a class="secondary-button" href={~p"/admin/app/balances"}>Manage balances</a>
    </p>
    <code>lib/photo_booth_bot_web/controllers/admin/*</code>
  </section>
</BotHTML.admin_shell>
