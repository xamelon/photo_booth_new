<.admin_shell current_admin={@current_admin} current_path={@current_path} wide={true}>
  <div class="page-header">
    <div>
      <a class="back-link" href={~p"/admin/bot/users"}>← Users</a>
      <h1>{@user.user.channel}:{@user.user.external_id}</h1>
      <p class="page-subtitle">
        {connection_label(@user.user)} · {@user.user.display_name || "Bot user"}
      </p>
    </div>
    <.badge status={if @user.user.blocked_at, do: "blocked", else: "active"} />
  </div>

  <section class="panel chat-admin-panel">
    <div class="chat-admin-thread">
      <div
        :for={message <- @user.transcript}
        class={["admin-chat-message", "admin-chat-#{message.author}"]}
      >
        <div class="admin-chat-bubble">
          <div class="admin-chat-meta">
            <strong>{message.author}</strong>
            <span>{format_time(message.at)}</span>
            <span>{message.status}</span>
          </div>
          <p>{message.text}</p>
          <details class="raw-details">
            <summary>json</summary>
            <pre><code>{pretty_json(message.raw)}</code></pre>
          </details>
        </div>
      </div>
      <p :if={@user.transcript == []} class="empty">No messages yet.</p>
    </div>

    <form
      method="post"
      action={~p"/admin/bot/users/#{@user.user.id}/send"}
      class="admin-chat-composer"
    >
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <input name="text" placeholder="Reply as admin" autocomplete="off" />
      <button>Send</button>
    </form>
  </section>

  <div class="detail-grid">
    <section class="panel detail-section">
      <div class="section-heading">
        <div>
          <h2>Sessions</h2>
          <p>Last 20 flow runs for this user.</p>
        </div>
        <span>{@user.sessions |> length}</span>
      </div>
      <table>
        <thead>
          <tr>
            <th>Flow</th><th>Node</th><th>State</th><th>Updated</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={session <- @user.sessions}>
            <td><code>{session.flow_id} v{session.flow_version}</code></td>
            <td><code>{session.current_node_id}</code></td>
            <td>{if session.completed_at, do: "completed", else: "active"}</td>
            <td>{format_time(session.updated_at)}</td>
          </tr>
        </tbody>
      </table>
      <p :if={@user.sessions == []} class="empty">No sessions.</p>
    </section>

    <section class="panel detail-section">
      <div class="section-heading">
        <div>
          <h2>Latest context</h2>
          <p>Session memory used by messages, actions and conditions.</p>
        </div>
      </div>
      <% active =
        Enum.find(@user.sessions, &is_nil(&1.completed_at)) || List.first(@user.sessions) %>
      <pre class="json-block"><code>{pretty_json(active && active.context)}</code></pre>
    </section>
  </div>
</.admin_shell>
