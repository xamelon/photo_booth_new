<.admin_shell current_admin={@current_admin} current_path={@current_path} wide={true}>
  <h1>{@title}</h1>

  <form method="get" action={@path} class="filter-bar">
    <select name="status">
      <option value="">all statuses</option>
      <option
        :for={status <- ["pending", "processing", "processed", "sent", "failed"]}
        value={status}
        selected={@filters["status"] == status}
      >
        {status}
      </option>
    </select>
    <select name="connection_id">
      <option value="">all connections</option>
      <option
        :for={connection <- @connections}
        value={connection.id}
        selected={@filters["connection_id"] == to_string(connection.id)}
      >
        {connection.name}
      </option>
    </select>
    <input name="q" value={@filters["q"]} placeholder="external id" />
    <button class="secondary-button compact-button">Filter</button>
    <a class="inline-link" href={@path}>clear</a>
  </form>

  <section class="panel dense-panel table-scroll">
    <table class="ops-table queue-table sticky-table">
      <thead>
        <tr>
          <th>Status</th><th>Connection</th><th>User</th><th class="num">Attempts</th><th>
            Summary
          </th><th>Error</th><th>Raw</th>
        </tr>
      </thead>
      <%= for row <- @rows do %>
        <tbody class="raw-row-group">
          <tr
            class="click-row"
            onclick="this.closest('tbody').querySelector('.raw-full-row').toggleAttribute('hidden')"
          >
            <td><.badge status={row.status} /></td>
            <td>{connection_label(row)}</td>
            <td><code>{row.channel}:{row.external_id}</code></td>
            <td class="num">{row.attempts}</td>
            <td class="summary-cell">{payload_summary(row.payload)}</td>
            <td class="error-cell compact-log">{row.last_error}</td>
            <td><span class="raw-toggle">json</span></td>
          </tr>
          <tr class="raw-full-row" hidden>
            <td colspan="7"><pre><code>{pretty_json(row.payload)}</code></pre></td>
          </tr>
        </tbody>
      <% end %>
    </table>
    <p :if={@rows == []} class="empty">Nothing here yet.</p>
  </section>
</.admin_shell>
