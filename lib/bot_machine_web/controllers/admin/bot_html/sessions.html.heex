<.admin_shell current_admin={@current_admin} current_path={@current_path} wide={true}>
  <h1>Sessions</h1>

  <form method="get" action={~p"/admin/bot/sessions"} class="filter-bar">
    <select name="connection_id">
      <option value="">all connections</option>
      <option
        :for={connection <- @connections}
        value={connection.id}
        selected={@filters["connection_id"] == to_string(connection.id)}
      >
        {connection.name}
      </option>
    </select>
    <select name="flow_id">
      <option value="">all flows</option>
      <option :for={flow <- @flows} value={flow.slug} selected={@filters["flow_id"] == flow.slug}>
        {flow.name}
      </option>
    </select>
    <input name="q" value={@filters["q"]} placeholder="external id" />
    <button class="secondary-button compact-button">Filter</button>
    <a class="inline-link" href={~p"/admin/bot/sessions"}>clear</a>
  </form>

  <section class="panel dense-panel table-scroll">
    <table class="ops-table sticky-table">
      <thead>
        <tr>
          <th>Connection</th><th>User</th><th>Flow</th><th>Node</th><th>Updated</th><th>
            Context
          </th>
        </tr>
      </thead>
      <tbody>
        <%= for session <- @sessions do %>
          <tr class="click-row" onclick="this.nextElementSibling.toggleAttribute('hidden')">
            <td>{connection_label(session)}</td>
            <td><code>{session.bot_user.channel}:{session.bot_user.external_id}</code></td>
            <td><code>{session.flow_id}@{session.flow_version}</code></td>
            <td><code>{session.current_node_id}</code></td>
            <td class="mono-cell">{format_time(session.updated_at)}</td>
            <td><span class="raw-toggle">json</span></td>
          </tr>
          <tr class="raw-full-row" hidden>
            <td colspan="6"><pre><code>{pretty_json(session.context)}</code></pre></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p :if={@sessions == []} class="empty">No active sessions.</p>
  </section>
</.admin_shell>
