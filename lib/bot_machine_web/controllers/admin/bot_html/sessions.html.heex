<.admin_shell current_admin={@current_admin} current_path={@current_path}>
  <h1>Sessions</h1>

  <section class="panel">
    <table>
      <thead>
        <tr>
          <th>User</th><th>Node</th><th>Context</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={session <- @sessions}>
          <td>{session.bot_user.channel}:{session.bot_user.external_id}</td>
          <td><code>{session.current_node_id}</code></td>
          <td><code>{json(session.context)}</code></td>
        </tr>
      </tbody>
    </table>
    <p :if={@sessions == []} class="empty">No active sessions.</p>
  </section>
</.admin_shell>
