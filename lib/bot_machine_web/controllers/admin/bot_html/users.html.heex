<.admin_shell current_admin={@current_admin} current_path={@current_path}>
  <div class="page-header">
    <div>
      <h1>Users</h1>
      <p class="page-subtitle">Bot users by channel. Admin users are separate.</p>
    </div>
  </div>

  <section class="panel">
    <table>
      <thead>
        <tr>
          <th>User</th><th>Name</th><th>Sessions</th><th>Active node</th><th>Last seen</th><th>Status</th>
        </tr>
      </thead>
      <tbody>
        <tr :for={user <- @users}>
          <td>
            <a class="inline-link" href={~p"/admin/bot/users/#{user.id}"}>
              <code>{user.channel}:{user.external_id}</code>
            </a>
          </td>
          <td>{user.display_name || "—"}</td>
          <td>{user.sessions_count}</td>
          <td><code>{(user.active_session && user.active_session.current_node_id) || "—"}</code></td>
          <td>{format_time(user.last_seen_at || user.updated_at)}</td>
          <td><.badge status={if user.blocked_at, do: "blocked", else: "active"} /></td>
        </tr>
      </tbody>
    </table>
    <p :if={@users == []} class="empty">No bot users yet.</p>
  </section>
</.admin_shell>
