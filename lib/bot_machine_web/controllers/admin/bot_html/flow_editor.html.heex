<.admin_shell current_admin={@current_admin} current_path={@current_path} wide={true}>
  <div class="page-header">
    <div>
      <a class="back-link" href={~p"/admin/bot/flows"}>← Flows</a>
      <h1>Edit {@version.bot_flow.name}</h1>
      <p class="page-subtitle">
        Сохраняет текущий flow. Custom actions выбираются из registry.
      </p>
    </div>
    <div class="page-actions">
      <a class="secondary-button" href={~p"/admin/bot/flows/#{@version.id}/view"}>View</a>
      <button class="flow-editor-save" type="submit" form="flow-editor-form">Save</button>
    </div>
  </div>

  <section :if={@errors != []} class="editor-errors">
    <strong>Cannot save</strong>
    <ul>
      <li :for={error <- @errors}>{error}</li>
    </ul>
  </section>

  <section class="flow-editor-panel">
    <form id="flow-editor-form" method="post" action={~p"/admin/bot/flows/#{@version.id}/edit"}>
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <textarea id="flow-editor-definition" name="definition" hidden></textarea>
    </form>
    <div id="flow-editor" class="flow-editor"></div>
    <script type="application/json" id="flow-editor-data">
      <%= raw(@editor_json) %>
    </script>
  </section>
</.admin_shell>
